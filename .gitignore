node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python environments, bytecode & caches
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
*.so
.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets (Keep .env.example tracked)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Android / Mobile Build Artifacts & Gradle Caches
frontend-v2/android/.gradle/
frontend-v2/android/build/
frontend-v2/android/app/build/
frontend-v2/android/captures/
frontend-v2/android/.idea/
frontend-v2/android/*.iml
frontend-v2/android/local.properties
.gradle/

# Temporary / Shell Artifacts
'
