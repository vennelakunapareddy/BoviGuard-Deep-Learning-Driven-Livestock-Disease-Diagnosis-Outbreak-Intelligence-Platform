# .env.example

# MongoDB URI
MONGODB_URI=mongodb://localhost:27017/animal-health

# Server Port
PORT=3000

# Authentication JWT Secret
JWT_SECRET=buffalo_health_secret_key_change_in_production

# ML Service Settings
BUFFALO_DETECTION_THRESHOLD=1.5
PREDICTION_CONFIDENCE_THRESHOLD=40.0

# Optional Google Maps / Places API Key for Nearby Veterinary Hospitals
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# Email / Password Recovery SMTP Configuration (Optional: for direct Gmail delivery)
# To send directly to your personal inbox, generate an App Password in Google Account (Security -> App passwords):
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Buffalo Health AI" <no-reply@buffalohealth.org>