# Auto-detect text files and normalize line endings
* text=auto

# Keep Windows shell scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep Unix scripts with LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.xlsx binary
*.apk binary
*.pth binary
*.pt binary
*.zip binary
